# ==============================================================================
# ConnectSpace Environment Variables Configuration
# ==============================================================================

# Supabase Configuration (Required)
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (Server-side migrations & admin setup only)
# NEVER expose this key in client-side code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Dedicated Port Isolation URLs (Defaults for ConnectSpace)
NEXT_PUBLIC_APP_URL=http://localhost:3017
NEXT_PUBLIC_API_URL=http://localhost:4017
NEXT_PUBLIC_SIGNALING_URL=http://localhost:5017
